DATABASE_URL=postgresql://clarity_app:CHANGE_ME@127.0.0.1:55432/clarity_portal
# Put migration credentials in .env.migration, not the web-service environment.
APP_ORIGIN=http://127.0.0.1:4317
PORT=4317
HOST=127.0.0.1
NODE_ENV=development
DATABASE_POOL_SIZE=10
# Required for remote production PostgreSQL. URL must not include ssl query parameters.
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA_FILE=/app/certs/rds-global-bundle.pem
# RUNTIME_DIR=/app/.runtime
DOCUMENT_RETENTION_HOURS=2
MAX_QUEUED_DOCUMENTS=3
# Set only when a loopback reverse proxy overwrites X-Forwarded-For.
# TRUST_PROXY=loopback
# For a private ECS task reachable ONLY from its ALB security group (append XFF, client ports disabled):
# TRUST_PROXY=alb
# Configure in a secret manager; never send to browser or logs.
TEMPORARY_PASSWORD=
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
# PYTHON_PATH=D:/claims-pdf-reader/.venv/Scripts/python.exe
# Internal loopback OCR port (defaults to PORT + 2 in run_portal.py).
# OCR_WORKER_PORT=4319
# Supervisor generates a fresh private worker token unless configured explicitly.
# OCR_WORKER_TOKEN=
# Existing PostgreSQL sessions are retained; no signed-cookie session migration.
# DJANGO_SECRET_KEY=
